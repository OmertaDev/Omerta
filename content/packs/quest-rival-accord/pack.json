      "type": "puzzle",
      "payload": {
        "title": "The First House's Receipt",
        "prompt": "The first house claims ownership because its receipt says purchased. The same signed receipt specifies twelve crates, while the dispute concerns one borrowed press. Which detail limits that claim?",
        "summary": "The first house claims ownership because its receipt says purchased. The same signed receipt specifies twelve crates, while the dispute concerns one borrowed press. Which detail limits that claim?",
        "gates": [
          {
            "kind": "party_role",
            "role": "mediator"
          }
        ],
        "answerMode": "server_owned_canonical",
        "answerSpecId": "house-ledger-answer",
        "interaction": {
          "kind": "deduction",
          "items": [
            {
              "id": "crates",
              "label": "The receipt purchases twelve crates"
            },
            {
              "id": "word",
              "label": "The word purchased by itself"
            }
          ]
        },
        "hints": [
          "Separate each witness claim from the evidence that can check it.",
          "Compare the stated constraints before choosing an arrangement."
        ]
      }
    },
