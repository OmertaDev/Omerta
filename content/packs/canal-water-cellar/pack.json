      "type": "chapter",
      "payload": {
        "title": "The Rising Line"
      }
    },
    {
      "id": "dry-valve-puzzle",
      "type": "puzzle",
      "payload": {
        "title": "The Dry Valve",
        "prompt": "What symbol is chalked above the only dry valve?",
