          {
            "kind": "party_role",
            "role": "investigator"
          },
          {
            "kind": "at_location",
            "locationId": "canal-location"
          }
        ],
        "options": [
          {
            "id": "medicine",
            "label": "The Doc's medicine crates"
          },
          {
            "id": "ledger",
            "label": "The landlord's deed ledger"
          },
          {
            "id": "neighbor",
            "label": "The old tenant who refuses to leave"
          }
        ]
      }
    },
    {
      "id": "knock-puzzle",
      "type": "puzzle",
      "payload": {
        "title": "The House Call",
        "prompt": "How many knocks mean the Doc sent help?",
        "gates": [
          {
