      "id": "madames-red-page-answer",
      "type": "answer_spec",
      "payload": {
        "verifier": "normalized_exact",
        "acceptedValues": [
          "e v",
          "ev"
        ]
      }
    },
    {
      "id": "ledger-verdict",
      "type": "choice",
      "payload": {
        "title": "Balance of Power",
        "prompt": "The hostile ledger is complete and the rival's acquisition clock has one hour left. How do you close the books?",
        "gates": [
          {
            "kind": "party_role",
            "role": "investigator"
          }
        ],
        "options": [
          {
            "id": "absorb-the-books",
            "label": "Buy the exposed debt and absorb the hostile books",
            "storyFlagIds": [
              "books-absorbed-flag"
            ]
          },
          {
            "id": "broker-the-collapse",
            "label": "Reverse the paper and make the takeover consume itself",
            "gates": [
              {
                "kind": "skill_owned",
                "skillId": "broker"
              },
              {
                "kind": "mastery_at_least",
                "trackId": "commerce",
                "level": 10
              },
              {
                "kind": "discipline_at_least",
                "disciplineId": "presence",
                "level": 8
              }
            ],
            "storyFlagIds": [
              "hostile-books-exposed-flag"
            ]
          },
          {
            "id": "madames-accord",
            "label": "Return the stolen accounts and bind the Madame to an honest settlement",
            "gates": [
              {
                "kind": "honor_at_least",
                "honor": 25
              },
              {
                "kind": "underworld_standing_at_least",
                "npcId": "madame",
                "standing": 25
              }
            ],
            "storyFlagIds": [
              "madames-accord-flag"
            ]
          }
        ]
      }
    },
    {
      "id": "books-absorbed-flag",
      "type": "story_flag",
      "payload": {
        "key": "omerta.case.path.ledger.hostile-books.outcome",
