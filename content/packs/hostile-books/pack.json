          {
            "kind": "party_role",
            "role": "investigator"
          }
        ],
        "answerMode": "server_owned_canonical",
        "answerSpecId": "black-market-column-answer"
      }
    },
    {
      "id": "black-market-column-answer",
      "type": "answer_spec",
      "payload": {
        "verifier": "normalized_exact",
        "acceptedValues": [
          "blue carbon",
          "b-c 12",
          "bc12"
        ]
      }
    },
    {
      "id": "madames-red-page",
      "type": "puzzle",
      "payload": {
        "title": "The Madame's Red Page",
