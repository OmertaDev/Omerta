    {
      "id": "investigator",
      "type": "role",
      "payload": {
        "title": "Investigator",
        "participantKinds": [
          "agent",
          "human_eligible_non_agent"
        ]
      }
    },
    {
      "id": "numbers-at-war",
      "type": "chapter",
      "payload": {
        "title": "Numbers at War"
      }
    },
    {
      "id": "orphaned-invoice",
      "type": "puzzle",
      "payload": {
        "title": "The Orphaned Invoice",
        "prompt": "Which shell company is billed for stock that never entered any warehouse?",
        "gates": [
          {
            "kind": "party_role",
            "role": "investigator"
          }
        ],
        "answerMode": "server_owned_canonical",
        "answerSpecId": "orphaned-invoice-answer"
      }
    },
    {
      "id": "orphaned-invoice-answer",
      "type": "answer_spec",
      "payload": {
        "verifier": "normalized_exact",
        "acceptedValues": [
          "north crown imports",
          "north crown"
        ]
      }
    },
    {
      "id": "split-loan",
      "type": "puzzle",
      "payload": {
        "title": "The Split Loan",
        "prompt": "What fraction of each defaulted loan is quietly transferred into the acquisition column?",
        "gates": [
          {
            "kind": "party_role",
            "role": "investigator"
          }
        ],
        "answerMode": "server_owned_canonical",
        "answerSpecId": "split-loan-answer"
      }
    },
    {
      "id": "split-loan-answer",
      "type": "answer_spec",
      "payload": {
        "verifier": "normalized_exact",
        "acceptedValues": [
          "three eighths",
          "3/8"
        ]
      }
    },
    {
      "id": "black-market-column",
      "type": "puzzle",
      "payload": {
        "title": "The Black-Market Column",
        "prompt": "Which commodity code disguises the payments used to corner the private market?",
