      "type": "mystery",
      "payload": {
        "title": "The Bad Batch",
        "summary": "A kitchen crew is collapsing around a batch that passed every ordinary test. The poison is hidden in the process, the supply book, or the people trusted to sign both.",
        "systems": [
          "kitchen",
          "goods-market",
          "skills",
          "mastery",
          "regimen",
          "honor",
          "underworld"
        ],
        "gates": [
          {
            "kind": "path_is",
            "pathId": "kitchen"
          }
        ]
      }
    },
    {
