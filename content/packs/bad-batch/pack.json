          {
            "kind": "party_role",
            "role": "investigator"
          }
        ],
        "answerMode": "server_owned_canonical",
        "answerSpecId": "copper-assay-answer"
      }
    },
    {
      "id": "copper-assay-answer",
      "type": "answer_spec",
      "payload": {
        "verifier": "normalized_exact",
        "acceptedValues": [
          "violet",
          "violet ring"
        ]
      }
    },
    {
      "id": "split-manifest",
      "type": "puzzle",
      "payload": {
        "title": "The Split Manifest",
        "prompt": "Which supplier mark appears only on the drums routed through the false storeroom?",
