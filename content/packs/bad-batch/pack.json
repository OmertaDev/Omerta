                "kind": "mastery_at_least",
                "trackId": "chemistry",
                "level": 10
              },
              {
                "kind": "discipline_at_least",
                "disciplineId": "composure",
                "level": 8
              }
            ],
            "storyFlagIds": [
              "proofed-process-flag"
            ]
          },
          {
            "id": "trace-the-source",
            "label": "Trace the poison to its source and give the survivors the full record",
            "gates": [
              {
                "kind": "honor_at_least",
                "honor": 25
              },
              {
                "kind": "underworld_standing_at_least",
                "npcId": "doc",
                "standing": 25
              }
            ],
            "storyFlagIds": [
              "source-traced-flag"
            ]
          }
        ]
      }
    },
    {
