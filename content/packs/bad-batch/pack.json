          {
            "kind": "party_role",
            "role": "investigator"
          }
        ],
        "answerMode": "server_owned_canonical",
        "answerSpecId": "cooling-clock-answer"
      }
    },
    {
      "id": "cooling-clock-answer",
      "type": "answer_spec",
      "payload": {
        "verifier": "normalized_exact",
        "acceptedValues": [
          "minute seventeen",
