    },
    {
      "from": "the-first-night",
      "type": "UNLOCKS",
      "to": "read-the-opening-column"
    },
    {
      "from": "read-the-opening-column",
      "type": "UNLOCKS",
      "to": "find-the-dry-seal"
    },
    {
      "from": "find-the-dry-seal",
      "type": "UNLOCKS",
      "to": "write-the-first-line"
    },
    {
      "from": "write-the-first-line",
      "type": "UNLOCKS",
      "to": "midnight-memory"
    },
    {
      "from": "midnight-memory",
      "type": "UNLOCKS",
      "to": "case-closed"
    }
  ]
}
