real Postgres	Stop containers	2026-09-20T23:38:05.9823439Z  	-- LOAN SHARKING — the Shylock. An OPEN row is an escrowed offer (principal held like a bounty pot);
real Postgres	Stop containers	2026-09-20T23:38:05.9823579Z  	-- a TAKEN row is an ACTIVE debt (principal already with the borrower). Escrow (SUM principal WHERE
real Postgres	Stop containers	2026-09-20T23:38:05.9823714Z  	-- status='open') reconciles against the loan:* ledger (§10.4). `rate` is the interest fraction; the
real Postgres	Stop containers	2026-09-20T23:38:05.9823833Z  	-- outstanding debt is principal×(1+rate). Numbers are founder sign-off levers.
real Postgres	Stop containers	2026-09-20T23:38:05.9823887Z  	CREATE TABLE IF NOT EXISTS loans (
real Postgres	Stop containers	2026-09-20T23:38:05.9823933Z  	  id TEXT PRIMARY KEY,
real Postgres	Stop containers	2026-09-20T23:38:05.9823986Z  	  lender_character TEXT NOT NULL,
real Postgres	Stop containers	2026-09-20T23:38:05.9824097Z  	  borrower_character TEXT,                          -- NULL while open (offered, untaken)
real Postgres	Stop containers	2026-09-20T23:38:05.9824147Z  	  principal NUMERIC NOT NULL,
real Postgres	Stop containers	2026-09-20T23:38:05.9824197Z  	  rate NUMERIC NOT NULL,
real Postgres	Stop containers	2026-09-20T23:38:05.9824246Z  	  hours INT NOT NULL,
real Postgres	Stop containers	2026-09-20T23:38:05.9824368Z  	  status TEXT NOT NULL DEFAULT 'open',              -- open | active | repaid | collected | cancelled
real Postgres	Stop containers	2026-09-20T23:38:05.9824497Z  	  offered_at TIMESTAMPTZ NOT NULL DEFAULT now(),
real Postgres	Stop containers	2026-09-20T23:38:05.9824547Z  	  due_at TIMESTAMPTZ,
real Postgres	Stop containers	2026-09-20T23:38:05.9824714Z  	  offered_to TEXT,                                  -- step 2: directed (trust-line) offer — only this borrower can take (NULL = open board)
real Postgres	Stop containers	2026-09-20T23:38:05.9824878Z  	  collateral_min NUMERIC NOT NULL DEFAULT 0,        -- step 2: a SECURED offer requires a car worth ≥ this (0 = unsecured)
real Postgres	Stop containers	2026-09-20T23:38:05.9825045Z  	  collateral_car TEXT,                              -- step 2: the pledged car id once taken (NULL = none); seized to the lender on default
real Postgres	Stop containers	2026-09-20T23:38:05.9825237Z  	  for_sale NUMERIC                                  -- step 3: the paper market — the current lender's ASK price on this active loan (NULL = not for sale)
real Postgres	Stop containers	2026-09-20T23:38:05.9825278Z  	);
real Postgres	Stop containers	2026-09-20T23:38:05.9825415Z  	-- Drop 5 (B — $OMR-collateralized loans): the lender's $OMR demand on an OPEN row; the ESCROWED
real Postgres	Stop containers	2026-09-20T23:38:05.9825610Z  	-- pledge itself once ACTIVE (invariants sums it over status='active' as a §10.4 $OMR bucket +
real Postgres	Stop containers	2026-09-20T23:38:05.9825735Z  	-- the `loan omr pledge escrow` check). An ALTER, never inline — `loans` is a live table and a
real Postgres	Stop containers	2026-09-20T23:38:05.9825845Z  	-- CREATE TABLE IF NOT EXISTS is a no-op on one (the 2026-08-06 boot-outage class).
real Postgres	Stop containers	2026-09-20T23:38:05.9825962Z  	ALTER TABLE loans ADD COLUMN IF NOT EXISTS collateral_omr NUMERIC NOT NULL DEFAULT 0;
