real Postgres	Stop containers	2026-09-20T23:38:05.9797105Z  	  buyin INT NOT NULL,
real Postgres	Stop containers	2026-09-20T23:38:05.9797244Z  	  racer_name TEXT NOT NULL,               -- the entered racer's name (for display; the racer isn't escrowed)
real Postgres	Stop containers	2026-09-20T23:38:05.9797297Z  	  kind TEXT NOT NULL,
real Postgres	Stop containers	2026-09-20T23:38:05.9797444Z  	  form INT NOT NULL,                      -- the racer's form snapshotted at entry (the race is form + rand(VARIANCE))
real Postgres	Stop containers	2026-09-20T23:38:05.9797528Z  	  place INT,                             -- final placing, filled at settle
real Postgres	Stop containers	2026-09-20T23:38:05.9797584Z  	  PRIMARY KEY (race_id, character_id)
real Postgres	Stop containers	2026-09-20T23:38:05.9797623Z  	);
