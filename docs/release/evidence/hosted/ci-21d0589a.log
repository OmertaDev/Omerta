real Postgres	Stop containers	2026-09-20T23:38:05.9787029Z  	-- ── THE SPEAKEASY: the social hub (omerta-speakeasy-design.md) ──
real Postgres	Stop containers	2026-09-20T23:38:05.9787179Z  	-- ONE club per district (district_id PK, the territory-racket pattern), owned by a character. The base
real Postgres	Stop containers	2026-09-20T23:38:05.9787324Z  	-- bar take accrues lazily (income_at, capped 24h) → the owner's pocket. Prestige (stored) is bumped by
real Postgres	Stop containers	2026-09-20T23:38:05.9787469Z  	-- rounds + bottles and floored by the decor tier; it ranks the nightlife. Dies with the proprietor's
real Postgres	Stop containers	2026-09-20T23:38:05.9787610Z  	-- street (the business precedent). §10.4: all cash flows carry a character_id (speakeasy: vocabulary).
real Postgres	Stop containers	2026-09-20T23:38:05.9787670Z  	CREATE TABLE IF NOT EXISTS speakeasies (
real Postgres	Stop containers	2026-09-20T23:38:05.9787725Z  	  district_id TEXT PRIMARY KEY,
real Postgres	Stop containers	2026-09-20T23:38:05.9787777Z  	  owner_character TEXT NOT NULL,
real Postgres	Stop containers	2026-09-20T23:38:05.9787901Z  	  name TEXT,
real Postgres	Stop containers	2026-09-20T23:38:05.9788020Z  	  tier INT NOT NULL DEFAULT 0,                      -- decor tier (0 = The Backroom, as opened)
real Postgres	Stop containers	2026-09-20T23:38:05.9788302Z  	  prestige NUMERIC NOT NULL DEFAULT 0,             -- bumped by rounds/bottles, floored by tier — the nightlife rank
real Postgres	Stop containers	2026-09-20T23:38:05.9788436Z  	  income_at TIMESTAMPTZ NOT NULL DEFAULT now(),    -- base bar-take accrual clock (lazy, capped)
real Postgres	Stop containers	2026-09-20T23:38:05.9788588Z  	  -- step two — the Prohibition RAID (the business-raid pattern): NOTORIETY accrues from the club's illicit
real Postgres	Stop containers	2026-09-20T23:38:05.9788743Z  	  -- activity (the back-room table + patronage), decays hourly; past the threshold the owner's collect rolls
real Postgres	Stop containers	2026-09-20T23:38:05.9788871Z  	  -- a lazy raid that seizes pending income + fines the owner + SHUTTERS the club (shut_until).
real Postgres	Stop containers	2026-09-20T23:38:05.9788928Z  	  notoriety NUMERIC NOT NULL DEFAULT 0,
real Postgres	Stop containers	2026-09-20T23:38:05.9788998Z  	  notoriety_at TIMESTAMPTZ NOT NULL DEFAULT now(),
real Postgres	Stop containers	2026-09-20T23:38:05.9789052Z  	  shut_until TIMESTAMPTZ,
real Postgres	Stop containers	2026-09-20T23:38:05.9789195Z  	  -- step three — the P2P BUYOUT: the owner lists a sale price (a consensual transfer, districts clear
real Postgres	Stop containers	2026-09-20T23:38:05.9789349Z  	  -- without a death); a buyer completes it via a taxed cash transfer (the round pattern). null = not for sale.
real Postgres	Stop containers	2026-09-20T23:38:05.9789395Z  	  sale_price NUMERIC,
real Postgres	Stop containers	2026-09-20T23:38:05.9789542Z  	  -- step three — the ETH COSMETIC DECOR tier: a display-only club skin (Store entitlement, account-level
real Postgres	Stop containers	2026-09-20T23:38:05.9789692Z  	  -- unlock in store_cosmetics, applied here). null = the stock look. Pure display — zero gameplay effect.
real Postgres	Stop containers	2026-09-20T23:38:05.9789737Z  	  decor_style TEXT,
real Postgres	Stop containers	2026-09-20T23:38:05.9789888Z  	  -- step four — the STANDOVER (a hostile forced-sale, an instant muscle contest): a per-club cooldown after
real Postgres	Stop containers	2026-09-20T23:38:05.9790023Z  	  -- any standover attempt (win or lose) so a club can't be leaned on back-to-back. null = fair game.
real Postgres	Stop containers	2026-09-20T23:38:05.9790077Z  	  standover_cd_until TIMESTAMPTZ,
real Postgres	Stop containers	2026-09-20T23:38:05.9790147Z  	  opened_at TIMESTAMPTZ NOT NULL DEFAULT now()
real Postgres	Stop containers	2026-09-20T23:38:05.9790192Z  	);
real Postgres	Stop containers	2026-09-20T23:38:05.9790306Z  	CREATE INDEX IF NOT EXISTS ix_speakeasies_owner ON speakeasies (owner_character);
real Postgres	Stop containers	2026-09-20T23:38:05.9790442Z  	-- the guest list: who frequents each club, what they've spent, whether they're a REGULAR (status).
real Postgres	Stop containers	2026-09-20T23:38:05.9790507Z  	CREATE TABLE IF NOT EXISTS speakeasy_patrons (
real Postgres	Stop containers	2026-09-20T23:38:05.9790558Z  	  district_id TEXT NOT NULL,
real Postgres	Stop containers	2026-09-20T23:38:05.9790607Z  	  character_id TEXT NOT NULL,
real Postgres	Stop containers	2026-09-20T23:38:05.9790659Z  	  visits INT NOT NULL DEFAULT 0,
real Postgres	Stop containers	2026-09-20T23:38:05.9790717Z  	  spent_cash NUMERIC NOT NULL DEFAULT 0,
real Postgres	Stop containers	2026-09-20T23:38:05.9790771Z  	  spent_omr NUMERIC NOT NULL DEFAULT 0,
real Postgres	Stop containers	2026-09-20T23:38:05.9790895Z  	  last_at TIMESTAMPTZ NOT NULL DEFAULT now(),       -- per-(patron,club) round cooldown
real Postgres	Stop containers	2026-09-20T23:38:05.9791045Z  	  -- step two anti-grief (audit HIGH-1): a per-(patron,club) daily notoriety BUDGET (token bucket) caps how
real Postgres	Stop containers	2026-09-20T23:38:05.9791191Z  	  -- much heat ONE patron can add to a club below the raid threshold — so no single account can force a raid;
real Postgres	Stop containers	2026-09-20T23:38:05.9791427Z  	  -- a hot club needs genuine distinct traffic (a busy den). Legit play is uncapped; only the heat it adds is.
real Postgres	Stop containers	2026-09-20T23:38:05.9791483Z  	  noto_used NUMERIC NOT NULL DEFAULT 0,
real Postgres	Stop containers	2026-09-20T23:38:05.9791545Z  	  noto_at TIMESTAMPTZ NOT NULL DEFAULT now(),
real Postgres	Stop containers	2026-09-20T23:38:05.9791605Z  	  PRIMARY KEY (district_id, character_id)
real Postgres	Stop containers	2026-09-20T23:38:05.9791646Z  	);
