real Postgres	Stop containers	2026-09-20T23:38:05.9791972Z  	-- THE FIGHT CIRCUIT (omerta-fight-circuit-design.md): a manager signs ONE contender — a persistent owned
real Postgres	Stop containers	2026-09-20T23:38:05.9792112Z  	-- asset with stats + a W/L record — and stakes them in PvP bouts (the casino:pvp transfer pattern). Dies
real Postgres	Stop containers	2026-09-20T23:38:05.9792265Z  	-- with the street (joins the runEstate wipe). bout_limit = consent-by-listing (the fade/bodyguard pattern).
real Postgres	Stop containers	2026-09-20T23:38:05.9792481Z  	-- THE FIGHT CIRCUIT (step two: THE STABLE) — a manager runs MANY fighters (BOXING.STABLE_MAX), so
real Postgres	Stop containers	2026-09-20T23:38:05.9792582Z  	-- the PK is a per-fighter id and character_id is the (non-unique) manager.
real Postgres	Stop containers	2026-09-20T23:38:05.9792637Z  	CREATE TABLE IF NOT EXISTS fighters (
real Postgres	Stop containers	2026-09-20T23:38:05.9792686Z  	  id TEXT PRIMARY KEY,
real Postgres	Stop containers	2026-09-20T23:38:05.9792803Z  	  character_id TEXT NOT NULL,        -- the manager (a stable = many fighters per manager)
real Postgres	Stop containers	2026-09-20T23:38:05.9792851Z  	  name TEXT NOT NULL,
real Postgres	Stop containers	2026-09-20T23:38:05.9792898Z  	  power INT NOT NULL,
real Postgres	Stop containers	2026-09-20T23:38:05.9792941Z  	  chin INT NOT NULL,
real Postgres	Stop containers	2026-09-20T23:38:05.9792987Z  	  speed INT NOT NULL,
real Postgres	Stop containers	2026-09-20T23:38:05.9793040Z  	  wins INT NOT NULL DEFAULT 0,
real Postgres	Stop containers	2026-09-20T23:38:05.9793090Z  	  losses INT NOT NULL DEFAULT 0,
real Postgres	Stop containers	2026-09-20T23:38:05.9793199Z  	  injured_until TIMESTAMPTZ,        -- a lost bout lays the fighter up (no spam)
real Postgres	Stop containers	2026-09-20T23:38:05.9793324Z  	  bout_limit NUMERIC,               -- the stake this fighter will take (null = not taking bouts)
real Postgres	Stop containers	2026-09-20T23:38:05.9793434Z  	  exhib_at TIMESTAMPTZ,             -- per-fighter cooldown on NPC exhibition bouts
real Postgres	Stop containers	2026-09-20T23:38:05.9793574Z  	  booked_until TIMESTAMPTZ,         -- (step three) locked into a scheduled MAIN EVENT until it resolves
real Postgres	Stop containers	2026-09-20T23:38:05.9793642Z  	  created_at TIMESTAMPTZ NOT NULL DEFAULT now()
real Postgres	Stop containers	2026-09-20T23:38:05.9793682Z  	);
real Postgres	Stop containers	2026-09-20T23:38:05.9793779Z  	CREATE INDEX IF NOT EXISTS ix_fighters_char ON fighters (character_id);
real Postgres	Stop containers	2026-09-20T23:38:05.9793873Z  	CREATE INDEX IF NOT EXISTS ix_fighters_wins ON fighters (wins DESC);
real Postgres	Stop containers	2026-09-20T23:38:05.9794023Z  	-- THE STABLE: player-owned racing animals (dogs & horses) — the boxing-stable pattern under The Track's
real Postgres	Stop containers	2026-09-20T23:38:05.9794166Z  	-- betting card. Own many per owner; each has speed/stamina/heart, a record, an injury clock, a consent
real Postgres	Stop containers	2026-09-20T23:38:05.9794321Z  	-- listing (race_limit) + a per-racer circuit cooldown. Racers DIE WITH THE STREET (the fighters precedent).
real Postgres	Stop containers	2026-09-20T23:38:05.9794381Z  	CREATE TABLE IF NOT EXISTS racers (
real Postgres	Stop containers	2026-09-20T23:38:05.9794428Z  	  id TEXT PRIMARY KEY,
real Postgres	Stop containers	2026-09-20T23:38:05.9794537Z  	  character_id TEXT NOT NULL,        -- the owner (a stable = many racers per owner)
real Postgres	Stop containers	2026-09-20T23:38:05.9794632Z  	  kind TEXT NOT NULL,               -- 'dog' (greyhound) | 'horse' (racehorse)
real Postgres	Stop containers	2026-09-20T23:38:05.9794677Z  	  name TEXT NOT NULL,
real Postgres	Stop containers	2026-09-20T23:38:05.9794724Z  	  speed INT NOT NULL,
real Postgres	Stop containers	2026-09-20T23:38:05.9794773Z  	  stamina INT NOT NULL,
real Postgres	Stop containers	2026-09-20T23:38:05.9794817Z  	  heart INT NOT NULL,
real Postgres	Stop containers	2026-09-20T23:38:05.9794871Z  	  wins INT NOT NULL DEFAULT 0,
real Postgres	Stop containers	2026-09-20T23:38:05.9794922Z  	  losses INT NOT NULL DEFAULT 0,
real Postgres	Stop containers	2026-09-20T23:38:05.9795028Z  	  injured_until TIMESTAMPTZ,        -- a lost race lays the animal up (no spam)
real Postgres	Stop containers	2026-09-20T23:38:05.9795166Z  	  race_limit NUMERIC,               -- the wager this racer will take in a PvP match race (null = not listed)
real Postgres	Stop containers	2026-09-20T23:38:05.9795269Z  	  circuit_at TIMESTAMPTZ,           -- per-racer cooldown on the PvE circuit
real Postgres	Stop containers	2026-09-20T23:38:05.9795389Z  	  created_at TIMESTAMPTZ NOT NULL DEFAULT now()
real Postgres	Stop containers	2026-09-20T23:38:05.9795430Z  	);
