real Postgres	Stop containers	2026-09-20T23:38:05.9795760Z  	-- THE STAKES (Stable step two): a scheduled marquee race owners enter their racer into — the Grand-Prix/
real Postgres	Stop containers	2026-09-20T23:38:05.9795910Z  	-- poker-tournament escrow twin on the animal side. A CASH buy-in escrows into a purse; the worker races
real Postgres	Stop containers	2026-09-20T23:38:05.9796054Z  	-- every live entrant's SNAPSHOTTED form and pays the top places net of rake (a pure redistribution). One
real Postgres	Stop containers	2026-09-20T23:38:05.9796198Z  	-- OPEN stakes at a time (stakes_state.current); a new one materializes on the next entry after the last
real Postgres	Stop containers	2026-09-20T23:38:05.9796320Z  	-- settles. §10.4: a `stakes escrow` check (pool == Σ buyin − win − refund − take − death).
real Postgres	Stop containers	2026-09-20T23:38:05.9796439Z  	CREATE TABLE IF NOT EXISTS stakes_races (
real Postgres	Stop containers	2026-09-20T23:38:05.9796486Z  	  id TEXT PRIMARY KEY,
real Postgres	Stop containers	2026-09-20T23:38:05.9796581Z  	  status TEXT NOT NULL DEFAULT 'open',    -- open → resolved | refunded
real Postgres	Stop containers	2026-09-20T23:38:05.9796647Z  	  opened_at TIMESTAMPTZ NOT NULL DEFAULT now(),
real Postgres	Stop containers	2026-09-20T23:38:05.9796774Z  	  resolves_at TIMESTAMPTZ NOT NULL,       -- registration closes here; the worker settles after
real Postgres	Stop containers	2026-09-20T23:38:05.9796859Z  	  pool INT NOT NULL DEFAULT 0             -- Σ escrowed buy-ins
real Postgres	Stop containers	2026-09-20T23:38:05.9796900Z  	);
