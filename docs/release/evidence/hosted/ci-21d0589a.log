real Postgres	Stop containers	2026-09-20T23:38:05.9799970Z  	  b_char TEXT NOT NULL, b_fighter TEXT NOT NULL, b_name TEXT NOT NULL,
real Postgres	Stop containers	2026-09-20T23:38:05.9800070Z  	  status TEXT NOT NULL DEFAULT 'booked',   -- booked → resolved / cancelled
