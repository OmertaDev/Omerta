real Postgres	Stop containers	2026-09-20T23:38:05.9798477Z  	  defenses INT NOT NULL DEFAULT 0,   -- (step four) the reign: successful title defenses since winning it
real Postgres	Stop containers	2026-09-20T23:38:05.9798628Z  	  last_defense TIMESTAMPTZ,          -- (step four) the mandatory-defense clock — an inactive champ is stripped
