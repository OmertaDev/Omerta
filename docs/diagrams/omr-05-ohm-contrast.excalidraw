    {"id":"oc-labels","type":"text","x":90,"y":346,"width":170,"height":348,"angle":0,"strokeColor":"#475569","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":516,"version":1,"versionNonce":5016,"isDeleted":false,"boundElements":null,"updated":1787558400000,"link":null,"locked":false,"fontSize":17,"fontFamily":3,"text":"GROWTH SOURCE\n\nSUPPLY RESPONSE\n\nGAME / CASH PIPE\n\nTREASURY\n\nDEFENSE\n\nPLAYER EXIT\n\nGOVERNANCE","textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"GROWTH SOURCE\n\nSUPPLY RESPONSE\n\nGAME / CASH PIPE\n\nTREASURY\n\nDEFENSE\n\nPLAYER EXIT\n\nGOVERNANCE","autoResize":true,"lineHeight":1.56},
    {"id":"oc-ohmbody","type":"text","x":310,"y":346,"width":405,"height":350,"angle":0,"strokeColor":"#334155","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":517,"version":1,"versionNonce":5017,"isDeleted":false,"boundElements":null,"updated":1787558400000,"link":null,"locked":false,"fontSize":16,"fontFamily":3,"text":"Rebase staking + discounted bonds\n\nReward-rate rebases and bond minting\n\nNo full RPG economy\n\nRFV framing; reserve assets\n\nPolicy / DAO parameters\n\nUnstake or sell on market\n\nDAO / policy team controlled levers","textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"Rebase staking + discounted bonds\n\nReward-rate rebases and bond minting\n\nNo full RPG economy\n\nRFV framing; reserve assets\n\nPolicy / DAO parameters\n\nUnstake or sell on market\n\nDAO / policy team controlled levers","autoResize":true,"lineHeight":1.65},
    {"id":"oc-omrbody","type":"text","x":770,"y":346,"width":530,"height":350,"angle":0,"strokeColor":"#334155","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":518,"version":1,"versionNonce":5018,"isDeleted":false,"boundElements":null,"updated":1787558400000,"link":null,"locked":false,"fontSize":16,"fontFamily":3,"text":"RPG demand; bond is contract's only extra mint\n\nNo gameplay schedule; staking is funded-pool redistribution\n\nCash cannot become OMR through game routes\n\nETH + POL + gated tokenized-stock rail\n\n3 revenue-rooted buybacks + automatic sink recycling\n\nMarket / one-way Window / full-reserve extraction*\n\nPlayers vote gameplay; supply walls live in contracts","textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"RPG demand; bond is contract's only extra mint\n\nNo gameplay schedule; staking is funded-pool redistribution\n\nCash cannot become OMR through game routes\n\nETH + POL + gated tokenized-stock rail\n\n3 revenue-rooted buybacks + automatic sink recycling\n\nMarket / one-way Window / full-reserve extraction*\n\nPlayers vote gameplay; supply walls live in contracts","autoResize":true,"lineHeight":1.65},
