    {"id":"s2-auction-body","type":"text","x":1140,"y":402,"width":362,"height":214,"angle":0,"strokeColor":"#eee6d7","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":20209,"version":1,"versionNonce":120209,"isDeleted":false,"boundElements":null,"updated":1787558400000,"link":null,"locked":false,"fontSize":15,"fontFamily":3,"text":"PRICE   1.50× → 1.00× anchor / 6h\nLOT     min(returned × surge,\n        float cap, shelf)\nBASE    ≤ 1% of player float / day\nSURGE   starts ≥ 1.10× 30d average\nCEILING ≤ 3% of float / day\nORACLE  stale >48h → no auction\nUNSOLD  rolls; nothing is invented\n\nETH OUT: 50% POL / 50% operations","textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"PRICE   1.50× → 1.00× anchor / 6h\nLOT     min(returned × surge,\n        float cap, shelf)\nBASE    ≤ 1% of player float / day\nSURGE   starts ≥ 1.10× 30d average\nCEILING ≤ 3% of float / day\nORACLE  stale >48h → no auction\nUNSOLD  rolls; nothing is invented\n\nETH OUT: 50% POL / 50% operations","autoResize":true,"lineHeight":1.3},
