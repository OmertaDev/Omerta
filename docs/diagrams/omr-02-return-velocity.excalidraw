    {"id":"rv-c3t","type":"text","x":934,"y":304,"width":365,"height":190,"angle":0,"strokeColor":"#065f46","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":214,"version":1,"versionNonce":2014,"isDeleted":false,"boundElements":null,"updated":1787558400000,"link":null,"locked":false,"fontSize":18,"fontFamily":3,"text":"3 · DAILY DESK AUCTION\n\nCan sell shelf inventory only.\nDutch price; reserve at upper band edge.\nBase lot ≤ 1% of float per day; upper\nleg may lift the hard ceiling to 3%.\nUnsold OMR rolls. ETH proceeds split:\n50% POL · 50% operations.","textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"3 · DAILY DESK AUCTION\n\nCan sell shelf inventory only.\nDutch price; reserve at upper band edge.\nBase lot ≤ 1% of float per day; upper\nleg may lift the hard ceiling to 3%.\nUnsold OMR rolls. ETH proceeds split:\n50% POL · 50% operations.","autoResize":true,"lineHeight":1.35},
