    {"id":"rv-s","type":"text","x":70,"y":158,"width":1220,"height":48,"angle":0,"strokeColor":"#475569","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":205,"version":1,"versionNonce":2005,"isDeleted":false,"boundElements":null,"updated":1787558400000,"link":null,"locked":false,"fontSize":19,"fontFamily":3,"text":"Most house OMR sinks do not destroy the token. They return it to the Desk, where a bounded daily auction\ncan sell only what the city actually collected. The KPI is return velocity, not theatrical scarcity.","textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"Most house OMR sinks do not destroy the token. They return it to the Desk, where a bounded daily auction\ncan sell only what the city actually collected. The KPI is return velocity, not theatrical scarcity.","autoResize":true,"lineHeight":1.25},
