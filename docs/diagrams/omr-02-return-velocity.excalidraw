    {"id":"s2-player-body","type":"text","x":90,"y":406,"width":295,"height":145,"angle":0,"strokeColor":"#eee6d7","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":20203,"version":1,"versionNonce":120203,"isDeleted":false,"boundElements":null,"updated":1787558400000,"link":null,"locked":false,"fontSize":16,"fontFamily":3,"text":"HOLD  Made ladder + access stakes\nCOMMIT  family dues + subscriptions\nUSE  seals + intel + gear + Brokers\nRISK  loose OMR can be looted\n\nDemand comes from play.\nNo action mints ERC-20 OMR.","textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"HOLD  Made ladder + access stakes\nCOMMIT  family dues + subscriptions\nUSE  seals + intel + gear + Brokers\nRISK  loose OMR can be looted\n\nDemand comes from play.\nNo action mints ERC-20 OMR.","autoResize":true,"lineHeight":1.33},
