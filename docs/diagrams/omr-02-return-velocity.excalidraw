    {"id":"rv-c2t","type":"text","x":514,"y":304,"width":280,"height":190,"angle":0,"strokeColor":"#9a3412","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":211,"version":1,"versionNonce":2011,"isDeleted":false,"boundElements":null,"updated":1787558400000,"link":null,"locked":false,"fontSize":18,"fontFamily":3,"text":"2 · HOUSE SINK\n\nA negative ledger row settles.\nThe sink reason is checked against\none shared Desk list. If matched,\nthe same amount credits shelf stock.\n\nOnly withdrawal is excluded:\nit leaves the game for the chain.","textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"2 · HOUSE SINK\n\nA negative ledger row settles.\nThe sink reason is checked against\none shared Desk list. If matched,\nthe same amount credits shelf stock.\n\nOnly withdrawal is excluded:\nit leaves the game for the chain.","autoResize":true,"lineHeight":1.35},
