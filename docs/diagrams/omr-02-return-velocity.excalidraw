    {"id":"s2-sink-body","type":"text","x":638,"y":338,"width":324,"height":145,"angle":0,"strokeColor":"#eee6d7","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":20206,"version":1,"versionNonce":120206,"isDeleted":false,"boundElements":null,"updated":1787558400000,"link":null,"locked":false,"fontSize":16,"fontFamily":3,"text":"A ledger debit settles first.\n\nIf its reason matches the explicit\nDESK.SINK_REASONS list, the exact\namount credits desk_inventory.\n\nwithdraw:omr is excluded: it exits.","textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"A ledger debit settles first.\n\nIf its reason matches the explicit\nDESK.SINK_REASONS list, the exact\namount credits desk_inventory.\n\nwithdraw:omr is excluded: it exits.","autoResize":true,"lineHeight":1.33},
