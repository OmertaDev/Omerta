    {"id":"rv-metrict","type":"text","x":94,"y":694,"width":1200,"height":38,"angle":0,"strokeColor":"#1e3a8a","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":218,"version":1,"versionNonce":2018,"isDeleted":false,"boundElements":null,"updated":1787558400000,"link":null,"locked":false,"fontSize":18,"fontFamily":3,"text":"RETURN VELOCITY = annual OMR recycled through revenue events ÷ circulating OMR\nA burn records one terminal event. A recycle can record the next one too.","textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"RETURN VELOCITY = annual OMR recycled through revenue events ÷ circulating OMR\nA burn records one terminal event. A recycle can record the next one too.","autoResize":true,"lineHeight":1.25},
