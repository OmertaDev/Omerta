    {"id":"rr-t","type":"text","x":70,"y":82,"width":1100,"height":60,"angle":0,"strokeColor":"#1e3a8a","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":404,"version":1,"versionNonce":4004,"isDeleted":false,"boundElements":null,"updated":1787558400000,"link":null,"locked":false,"fontSize":50,"fontFamily":3,"text":"The reserve cannot write an IOU.","textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"The reserve cannot write an IOU.","autoResize":true,"lineHeight":1.2},
    {"id":"rr-s","type":"text","x":70,"y":158,"width":1220,"height":48,"angle":0,"strokeColor":"#475569","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":405,"version":1,"versionNonce":4005,"isDeleted":false,"boundElements":null,"updated":1787558400000,"link":null,"locked":false,"fontSize":19,"fontFamily":3,"text":"Extraction and the RWA book are separate rails with the same conservation rule: assets must arrive before\nthe server can allocate or sign them. A promise is never counted as inventory.","textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"Extraction and the RWA book are separate rails with the same conservation rule: assets must arrive before\nthe server can allocate or sign them. A promise is never counted as inventory.","autoResize":true,"lineHeight":1.25},
    {"id":"rr-rule","type":"line","x":70,"y":222,"width":1260,"height":0,"angle":0,"strokeColor":"#94a3b8","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":406,"version":1,"versionNonce":4006,"isDeleted":false,"boundElements":null,"updated":1787558400000,"link":null,"locked":false,"points":[[0,0],[1260,0]],"lastCommittedPoint":null,"startBinding":null,"endBinding":null,"startArrowhead":null,"endArrowhead":null},
    {"id":"rr-ex","type":"rectangle","x":70,"y":266,"width":600,"height":356,"angle":0,"strokeColor":"#3b82f6","backgroundColor":"#dbeafe","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"roundness":{"type":3},"seed":407,"version":1,"versionNonce":4007,"isDeleted":false,"boundElements":null,"updated":1787558400000,"link":null,"locked":false},
    {"id":"rr-ext","type":"text","x":94,"y":290,"width":550,"height":296,"angle":0,"strokeColor":"#1e3a8a","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":408,"version":1,"versionNonce":4008,"isDeleted":false,"boundElements":null,"updated":1787558400000,"link":null,"locked":false,"fontSize":18,"fontFamily":3,"text":"RAIL A · FULL-RESERVE EXTRACTION\n\nREAL VIG REVENUE\n      ↓ buys OMR on market\nFUNDED WITHDRAWAL RESERVE\n      ↓ request enters queue\nCONSERVATION CHECK\ncommitted outstanding + request ≤ funded OMR\n      ↓ only then\nEIP-712 VOUCHER → ON-CHAIN CLAIM\n\nA short reserve queues. A claimed voucher does not\nmagically reopen signing room; the OMR already left.","textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"RAIL A · FULL-RESERVE EXTRACTION\n\nREAL VIG REVENUE\n      ↓ buys OMR on market\nFUNDED WITHDRAWAL RESERVE\n      ↓ request enters queue\nCONSERVATION CHECK\ncommitted outstanding + request ≤ funded OMR\n      ↓ only then\nEIP-712 VOUCHER → ON-CHAIN CLAIM\n\nA short reserve queues. A claimed voucher does not\nmagically reopen signing room; the OMR already left.","autoResize":true,"lineHeight":1.34},
    {"id":"rr-rwa","type":"rectangle","x":730,"y":266,"width":600,"height":356,"angle":0,"strokeColor":"#047857","backgroundColor":"#d1fae5","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"roundness":{"type":3},"seed":409,"version":1,"versionNonce":4009,"isDeleted":false,"boundElements":null,"updated":1787558400000,"link":null,"locked":false},
    {"id":"rr-rwat","type":"text","x":754,"y":290,"width":550,"height":296,"angle":0,"strokeColor":"#065f46","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":410,"version":1,"versionNonce":4010,"isDeleted":false,"boundElements":null,"updated":1787558400000,"link":null,"locked":false,"fontSize":18,"fontFamily":3,"text":"RAIL B · TREASURY RWA BOOK\n\nCOMMISSION VOTES ONE ALLOWED TICKER\n      ↓ gameplay choice, not monetary discretion\nKEEPER SPENDS ARRIVED TREASURY REVENUE\n      ↓ price-continuity wall\nTOKENIZED STOCK HELD ≥ UNITS ALLOCATED\n      ↓ frozen, deterministic activity weights\nSTOCKVAULT TRANSFER → STREET DEED TBA\n\nIdle capital earns nothing. Only sufficiently broad\nactive play qualifies. No random allocation.","textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"RAIL B · TREASURY RWA BOOK\n\nCOMMISSION VOTES ONE ALLOWED TICKER\n      ↓ gameplay choice, not monetary discretion\nKEEPER SPENDS ARRIVED TREASURY REVENUE\n      ↓ price-continuity wall\nTOKENIZED STOCK HELD ≥ UNITS ALLOCATED\n      ↓ frozen, deterministic activity weights\nSTOCKVAULT TRANSFER → STREET DEED TBA\n\nIdle capital earns nothing. Only sufficiently broad\nactive play qualifies. No random allocation.","autoResize":true,"lineHeight":1.34},
    {"id":"rr-inv","type":"rectangle","x":70,"y":660,"width":830,"height":95,"angle":0,"strokeColor":"#b45309","backgroundColor":"#fef3c7","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"roundness":{"type":3},"seed":411,"version":1,"versionNonce":4011,"isDeleted":false,"boundElements":null,"updated":1787558400000,"link":null,"locked":false},
    {"id":"rr-invt","type":"text","x":94,"y":679,"width":780,"height":58,"angle":0,"strokeColor":"#92400e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":412,"version":1,"versionNonce":4012,"isDeleted":false,"boundElements":null,"updated":1787558400000,"link":null,"locked":false,"fontSize":18,"fontFamily":3,"text":"TWO CONSERVATION INVARIANTS\nEXTRACTION: signed ≤ funded     RWA: delivered ≤ allocated ≤ held\nNightly reconciliation treats drift as an alarm, not a rounding story.","textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"TWO CONSERVATION INVARIANTS\nEXTRACTION: signed ≤ funded     RWA: delivered ≤ allocated ≤ held\nNightly reconciliation treats drift as an alarm, not a rounding story.","autoResize":true,"lineHeight":1.25},
