    {"id":"rr-cavt","type":"text","x":962,"y":679,"width":350,"height":58,"angle":0,"strokeColor":"#9a3412","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":414,"version":2,"versionNonce":4114,"isDeleted":false,"boundElements":null,"updated":1787558400000,"link":null,"locked":false,"fontSize":14,"fontFamily":3,"text":"DEED CAVEAT\nOnly assets still in the TBA follow\nthe deed. The owner may drain first.","textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"DEED CAVEAT\nOnly assets still in the TBA follow\nthe deed. The owner may drain first.","autoResize":true,"lineHeight":1.25},
