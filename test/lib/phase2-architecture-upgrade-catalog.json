      "definition": "CHECK (scope = 'global'::text AND subject_id = '*'::text OR scope <> 'global'::text AND subject_id <> '*'::text AND char_length(subject_id) > 0)"
    },
    {
      "table_name": "world_recipe_usage",
      "name": "world_recipe_usage_period_kind_check",
      "definition": "CHECK (period_kind = ANY (ARRAY['lifetime'::text, 'day'::text, 'week'::text, 'season'::text]))"
    },
    {
      "table_name": "world_recipe_usage",
      "name": "world_recipe_usage_pkey",
      "definition": "PRIMARY KEY (recipe_id, scope, subject_id, period_kind, period_key)"
    },
    {
      "table_name": "world_recipe_usage",
      "name": "world_recipe_usage_scope_check",
      "definition": "CHECK (scope = ANY (ARRAY['account'::text, 'global'::text, 'territory'::text]))"
    },
    {
      "table_name": "world_recipe_usage",
      "name": "world_recipe_usage_used_check",
      "definition": "CHECK (used >= 0 AND used <= 1000000)"
    }
  ],
