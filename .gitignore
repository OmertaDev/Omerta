node_modules/
.env
*.log
econ-sim.json

# Database dumps — `npm run backup` writes here (default BACKUP_DIR=./backups). A dump is a COMPLETE
# copy of the database: accounts, wallet addresses, the whole ledger. Committing one would publish
# every player's data permanently to git history, so it must never be stageable by accident.
backups/
*.dump
omerta-contracts/out-js/

# Foundry (CI/local build artifacts — deps + out are fetched/generated, never committed)
omerta-contracts/lib/
omerta-contracts/out/
omerta-contracts/cache/
# scratch build dirs from a pinned-version experiment (FOUNDRY_OUT=out-151 / FOUNDRY_CACHE_PATH=cache-151).
# tools/savepoint.sh runs `git add -A` as its L1 layer, so an unignored scratch dir gets STAGED and
# then committed — which is exactly how 218 build artifacts landed in a docs commit on 2026-08-29.
omerta-contracts/out-*/
omerta-contracts/cache-*/
omerta-contracts/broadcast/
baselines/
.hype-tmp/
.mcp_data/
.firecrawl/
# the motion library ships whole — every clip is wired by plate NAME through the /v1/art/motion
# manifest, so a clip in this directory IS in the game (the gitignored-directory CI 404 of
# 2026-08-14 is the reason this is stated rather than assumed)
probe-tmp.mjs
.worktrees/
.release-worktrees/
