      "endMs": 81971.021,
      "text": "Nico starts thinking beyond his next payout.",
      "timestampMs": null,
      "confidence": null
    },
    {
      "startMs": 82776.063,
      "endMs": 84941.917,
      "text": "What can he do that makes someone else want him around?",
      "timestampMs": null,
      "confidence": null
    },
    {
      "startMs": 90383.438,
      "endMs": 91829.917,
      "text": "He buys a sack of coffee.",
      "timestampMs": null,
      "confidence": null
    },
    {
      "startMs": 92734.271,
      "endMs": 95903.208,
      "text": "There is the price, the debit, and the cargo in his trunk.",
      "timestampMs": null,
      "confidence": null
    },
    {
      "startMs": 96790.5,
      "endMs": 98943.292,
      "text": "Getting a bargain is only half the decision.",
      "timestampMs": null,
      "confidence": null
    },
    {
      "startMs": 99861.021,
      "endMs": 100729.271,
      "text": "Goods need moving.",
      "timestampMs": null,
      "confidence": null
    },
    {
      "startMs": 101625.188,
      "endMs": 102761.646,
      "text": "Cars need repairs.",
      "timestampMs": null,
      "confidence": null
    },
    {
      "startMs": 103653.938,
      "endMs": 105936.896,
      "text": "Boats open sea runs with risks of their own.",
      "timestampMs": null,
      "confidence": null
    },
    {
      "startMs": 106830.542,
      "endMs": 109973.125,
      "text": "A business has upkeep; a Kitchen batch takes time.",
      "timestampMs": null,
      "confidence": null
    },
    {
      "startMs": 110866.896,
      "endMs": 115623.292,
      "text": "Races, boxing, the Den and the Speakeasy give people other reasons to return.",
      "timestampMs": null,
      "confidence": null
    },
    {
      "startMs": 116528.083,
      "endMs": 119985.229,
      "text": "Loans, auctions and fixers create other opportunities.",
      "timestampMs": null,
      "confidence": null
    },
    {
      "startMs": 120870.729,
      "endMs": 122643.021,
      "text": "The city rewards paying attention.",
      "timestampMs": null,
      "confidence": null
    },
    {
      "startMs": 125361.583,
      "endMs": 129646.417,
      "text": "Nico forms a Crew, a small circle for mutual aid and chat.",
      "timestampMs": null,
      "confidence": null
    },
    {
      "startMs": 130652.292,
      "endMs": 132666.667,
      "text": "Then comes the Payroll Office job.",
      "timestampMs": null,
      "confidence": null
    },
    {
      "startMs": 133656.708,
      "endMs": 135721.438,
      "text": "This heist needs a wheelman and muscle.",
      "timestampMs": null,
      "confidence": null
    },
    {
      "startMs": 136686.563,
      "endMs": 139619.208,
      "text": "Nico takes the wheelman role and puts up the stake.",
      "timestampMs": null,
      "confidence": null
    },
    {
      "startMs": 140600.854,
      "endMs": 142076.042,
      "text": "The second seat is empty.",
      "timestampMs": null,
      "confidence": null
    },
    {
      "startMs": 143066.729,
      "endMs": 143975.229,
      "text": "Mara joins.",
      "timestampMs": null,
      "confidence": null
    },
    {
      "startMs": 145008.313,
      "endMs": 146165.521,
      "text": "Both names are there.",
      "timestampMs": null,
      "confidence": null
    },
    {
      "startMs": 147241.188,
      "endMs": 149099.833,
      "text": "Preparation improves their odds.",
      "timestampMs": null,
      "confidence": null
    },
    {
      "startMs": 150085.417,
      "endMs": 153014.833,
      "text": "It cannot tell Nico what somebody else will choose.",
      "timestampMs": null,
      "confidence": null
    },
    {
      "startMs": 154006.417,
      "endMs": 154718.958,
      "text": "He commits.",
      "timestampMs": null,
      "confidence": null
    },
    {
      "startMs": 157254.604,
      "endMs": 158273.771,
      "text": "The law was waiting.",
      "timestampMs": null,
      "confidence": null
    },
    {
      "startMs": 159252.979,
      "endMs": 160253.333,
      "text": "Somebody talked.",
      "timestampMs": null,
      "confidence": null
    },
    {
      "startMs": 161941.917,
      "endMs": 163446.292,
      "text": "Both players go to jail.",
      "timestampMs": null,
      "confidence": null
    },
    {
      "startMs": 165994.625,
      "endMs": 167797.104,
      "text": "The result names no informant.",
      "timestampMs": null,
      "confidence": null
    },
    {
      "startMs": 168781.688,
      "endMs": 170997.854,
      "text": "Nico can read exactly what happened.",
      "timestampMs": null,
      "confidence": null
    },
    {
      "startMs": 171998.125,
      "endMs": 174108.542,
      "text": "He still does not know whom to believe.",
      "timestampMs": null,
      "confidence": null
    },
    {
      "startMs": 178357.104,
      "endMs": 179028.167,
      "text": "Jail ends.",
      "timestampMs": null,
      "confidence": null
    },
    {
      "startMs": 179910.771,
      "endMs": 181111.104,
      "text": "The question remains.",
      "timestampMs": null,
      "confidence": null
    },
    {
      "startMs": 182017.271,
      "endMs": 183896.604,
      "text": "Would you invite the same person again?",
      "timestampMs": null,
      "confidence": null
    },
    {
      "startMs": 184798.104,
      "endMs": 187823.604,
      "text": "Bigger risks can cost more: a character can die.",
      "timestampMs": null,
      "confidence": null
    },
    {
      "startMs": 188691,
      "endMs": 192439.958,
      "text": "Your account continues, but an heir keeps only a limited legacy.",
      "timestampMs": null,
      "confidence": null
    },
    {
      "startMs": 193330.042,
      "endMs": 194919.125,
      "text": "Seasons have their own rules.",
      "timestampMs": null,
      "confidence": null
    },
    {
      "startMs": 195805.875,
      "endMs": 200984.396,
      "text": "Eligible gear and vehicles can leave the game, but extracted items stop working inside it.",
      "timestampMs": null,
      "confidence": null
    },
    {
      "startMs": 201960.188,
      "endMs": 205446.021,
      "text": "Combat cannot take unrelated assets from your external wallet.",
      "timestampMs": null,
      "confidence": null
    },
    {
      "startMs": 206432.958,
      "endMs": 207664.333,
      "text": "What do you keep in play?",
      "timestampMs": null,
      "confidence": null
    },
    {
      "startMs": 208562.979,
      "endMs": 210034.958,
      "text": "What are you prepared to lose?",
      "timestampMs": null,
      "confidence": null
    },
    {
      "startMs": 212345.875,
      "endMs": 216304.917,
      "text": "Elsewhere in the city, discoveries can be kept private or shared with permission.",
      "timestampMs": null,
      "confidence": null
    },
    {
      "startMs": 217106.833,
      "endMs": 219913.75,
      "text": "Two investigators may need evidence they found independently.",
      "timestampMs": null,
      "confidence": null
    },
    {
      "startMs": 220704.313,
      "endMs": 222703.792,
      "text": "Copying the same clue is not another witness.",
      "timestampMs": null,
      "confidence": null
    },
    {
      "startMs": 223479.208,
      "endMs": 228633.75,
      "text": "Objects tell stories too: salvage becomes material, and an eligible recipe makes an item",
      "timestampMs": null,
      "confidence": null
    },
    {
      "startMs": 228633.75,
      "endMs": 229840.167,
      "text": "with a traceable history.",
      "timestampMs": null,
      "confidence": null
    },
    {
      "startMs": 230654.354,
      "endMs": 237083.854,
      "text": "Beyond Nico's small Crew, Families pursue larger ambitions: treasury, territory, rivalries and wars.",
      "timestampMs": null,
      "confidence": null
    },
    {
      "startMs": 237874,
      "endMs": 240297.229,
      "text": "Shared operations need contributions and approval.",
      "timestampMs": null,
      "confidence": null
    },
    {
      "startMs": 241090.917,
      "endMs": 242356.563,
      "text": "Convoys can be ambushed.",
      "timestampMs": null,
      "confidence": null
    },
    {
      "startMs": 243154.896,
      "endMs": 245580.896,
      "text": "Commission seats give votes on specific city rules.",
      "timestampMs": null,
      "confidence": null
    },
    {
      "startMs": 246363.063,
      "endMs": 250065.271,
      "text": "Events and the Director's authored situations change the opportunities around you.",
      "timestampMs": null,
      "confidence": null
    },
    {
      "startMs": 252336.667,
      "endMs": 253954.771,
      "text": "Not every rival is at a keyboard.",
      "timestampMs": null,
      "confidence": null
    },
    {
      "startMs": 254740.479,
      "endMs": 256213.396,
      "text": "A player can operate an agent.",
      "timestampMs": null,
      "confidence": null
    },
    {
      "startMs": 257024.604,
      "endMs": 259594,
      "text": "Here it reads its available actions and takes a street job.",
      "timestampMs": null,
      "confidence": null
    },
    {
      "startMs": 260381.729,
      "endMs": 262694.958,
      "text": "Nerve falls; cash and respect change.",
      "timestampMs": null,
      "confidence": null
    },
    {
      "startMs": 263475.667,
      "endMs": 265423.521,
      "text": "The next decision starts from that new state.",
      "timestampMs": null,
      "confidence": null
    },
    {
      "startMs": 266295.229,
      "endMs": 268597.104,
      "text": "Permissions and resources still limit what it can do.",
      "timestampMs": null,
      "confidence": null
    },
    {
      "startMs": 269375.417,
      "endMs": 271175.083,
      "text": "The city's NPCs are separate.",
      "timestampMs": null,
      "confidence": null
    },
    {
      "startMs": 271984.25,
      "endMs": 275971.083,
      "text": "Whether you bring friends or build an agent, the choices still have consequences.",
      "timestampMs": null,
      "confidence": null
    },
    {
      "startMs": 280336.75,
      "endMs": 282551.167,
      "text": "Nico needs equipment, access and people.",
      "timestampMs": null,
      "confidence": null
    },
    {
      "startMs": 283341.813,
      "endMs": 286121.083,
      "text": "Money helps, but the balances have different jobs.",
      "timestampMs": null,
      "confidence": null
    },
    {
      "startMs": 286925.646,
      "endMs": 288514.875,
      "text": "Game cash pays for city life.",
      "timestampMs": null,
      "confidence": null
    },
    {
      "startMs": 289315.063,
      "endMs": 294329.604,
      "text": "In-game OMR buys selected gear and services; some privileges require holding or staking it.",
      "timestampMs": null,
      "confidence": null
    },
    {
      "startMs": 295191.75,
      "endMs": 296919.854,
      "text": "Most OMR spends recycle it.",
      "timestampMs": null,
      "confidence": null
    },
    {
      "startMs": 297797.167,
      "endMs": 300131.625,
      "text": "Wallet OMR is separate, onchain.",
      "timestampMs": null,
      "confidence": null
    },
    {
      "startMs": 300937.479,
      "endMs": 303298.146,
      "text": "The funded Window spends OMR for game cash.",
      "timestampMs": null,
      "confidence": null
    },
    {
      "startMs": 304088.583,
      "endMs": 305460.854,
      "text": "That conversion goes one way.",
      "timestampMs": null,
      "confidence": null
    },
    {
      "startMs": 306252.521,
      "endMs": 308586.042,
      "text": "Game rewards are not automatic wallet payouts.",
      "timestampMs": null,
      "confidence": null
    },
    {
      "startMs": 309360.083,
      "endMs": 313057.875,
      "text": "Trading fees fund developer, community, asset and liquidity budgets.",
      "timestampMs": null,
      "confidence": null
    },
    {
      "startMs": 313832.896,
      "endMs": 316561.25,
      "text": "Inventory bonds release existing OMR over time.",
      "timestampMs": null,
      "confidence": null
    },
    {
      "startMs": 317361.75,
      "endMs": 320454.208,
      "text": "Liquidity rewards need eligible positions and funded campaigns.",
      "timestampMs": null,
      "confidence": null
    },
    {
      "startMs": 321253.438,
      "endMs": 324032.271,
      "text": "Some realized arbitrage profit can support reserves.",
      "timestampMs": null,
      "confidence": null
    },
    {
      "startMs": 324877.979,
      "endMs": 329248.854,
      "text": "Families compete for designated trading-fee rights; they do not take the pool's principal.",
      "timestampMs": null,
      "confidence": null
    },
    {
      "startMs": 330033.479,
      "endMs": 334348.646,
      "text": "Real-world assets include Stock Tokens: exposure to assets outside the game.",
      "timestampMs": null,
      "confidence": null
    },
    {
      "startMs": 335152.187,
      "endMs": 339279.917,
      "text": "Commission choices, acquisition, custody and eligibility govern the process.",
      "timestampMs": null,
      "confidence": null
    },
    {
      "startMs": 340068.083,
      "endMs": 342548.063,
      "text": "Holding OMR does not promise everyone a payout.",
      "timestampMs": null,
      "confidence": null
    },
    {
      "startMs": 343445.604,
      "endMs": 345585.438,
      "text": "These systems shape what players can organize.",
      "timestampMs": null,
      "confidence": null
    },
    {
      "startMs": 346374.708,
      "endMs": 348255.5,
      "text": "They cannot decide whom Nico should trust.",
      "timestampMs": null,
      "confidence": null
    },
    {
      "startMs": 351795.771,
      "endMs": 353274.458,
      "text": "The next job comes round.",
      "timestampMs": null,
      "confidence": null
    },
    {
      "startMs": 354160.396,
      "endMs": 354968.354,
      "text": "Another stake.",
      "timestampMs": null,
      "confidence": null
    },
    {
      "startMs": 355845.396,
      "endMs": 356927.479,
      "text": "Another empty seat.",
      "timestampMs": null,
      "confidence": null
    },
    {
      "startMs": 357821.542,
      "endMs": 364062.104,
      "text": "Nico has learned how to earn, how to specialize, and how much another person's decision can cost him.",
      "timestampMs": null,
      "confidence": null
    },
    {
      "startMs": 364950.438,
      "endMs": 367437.104,
      "text": "The next invitation is a choice he has to make.",
      "timestampMs": null,
      "confidence": null
    },
    {
      "startMs": 368325.979,
      "endMs": 369391.083,
      "text": "You can buy equipment.",
      "timestampMs": null,
      "confidence": null
    },
    {
      "startMs": 370281.021,
      "endMs": 371481.646,
      "text": "You cannot buy trust.",
      "timestampMs": null,
      "confidence": null
    },
    {
      "startMs": 372370.792,
      "endMs": 373256.708,
      "text": "Choose your path.",
      "timestampMs": null,
      "confidence": null
    },
    {
      "startMs": 374175.542,
      "endMs": 375114.708,
      "text": "Find your people.",
      "timestampMs": null,
      "confidence": null
    },
    {
      "startMs": 375996.104,
      "endMs": 376755.75,
      "text": "Make your name.",
      "timestampMs": null,
      "confidence": null
    },
    {
      "startMs": 377645.542,
      "endMs": 378275.292,
      "text": "OMERTÀ.",
      "timestampMs": null,
      "confidence": null
    },
    {
      "startMs": 379159.438,
      "endMs": 379974.479,
      "text": "Who will you bring?",
      "timestampMs": null,
      "confidence": null
    },
    {
      "startMs": 380881.958,
      "endMs": 383019.188,
      "text": "Start playing at omerta.fun.",
      "timestampMs": null,
      "confidence": null
    }
  ],
