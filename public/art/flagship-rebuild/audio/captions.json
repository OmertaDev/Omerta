    "timestampMs": null,
    "confidence": null
  },
  {
    "startMs": 271984.25,
    "endMs": 275971.083,
    "text": "Whether you bring friends or build an agent, the choices still have consequences.",
    "timestampMs": null,
    "confidence": null
  },
  {
    "startMs": 280336.75,
    "endMs": 282551.167,
    "text": "Nico needs equipment, access and people.",
    "timestampMs": null,
    "confidence": null
  },
  {
    "startMs": 283341.813,
    "endMs": 286121.083,
    "text": "Money helps, but the balances have different jobs.",
    "timestampMs": null,
    "confidence": null
  },
  {
    "startMs": 286925.646,
    "endMs": 288514.875,
    "text": "Game cash pays for city life.",
    "timestampMs": null,
    "confidence": null
  },
  {
    "startMs": 289315.063,
    "endMs": 294329.604,
    "text": "In-game OMR buys selected gear and services; some privileges require holding or staking it.",
    "timestampMs": null,
    "confidence": null
  },
  {
    "startMs": 295191.75,
    "endMs": 296919.854,
    "text": "Most OMR spends recycle it.",
    "timestampMs": null,
    "confidence": null
  },
  {
    "startMs": 297797.167,
    "endMs": 300131.625,
    "text": "Wallet OMR is separate, onchain.",
    "timestampMs": null,
    "confidence": null
  },
  {
    "startMs": 300937.479,
    "endMs": 303298.146,
    "text": "The funded Window spends OMR for game cash.",
    "timestampMs": null,
    "confidence": null
  },
  {
    "startMs": 304088.583,
    "endMs": 305460.854,
    "text": "That conversion goes one way.",
    "timestampMs": null,
    "confidence": null
  },
  {
    "startMs": 306252.521,
    "endMs": 308586.042,
    "text": "Game rewards are not automatic wallet payouts.",
    "timestampMs": null,
    "confidence": null
  },
  {
    "startMs": 309360.083,
    "endMs": 313057.875,
    "text": "Trading fees fund developer, community, asset and liquidity budgets.",
    "timestampMs": null,
    "confidence": null
  },
  {
    "startMs": 313832.896,
    "endMs": 316561.25,
    "text": "Inventory bonds release existing OMR over time.",
    "timestampMs": null,
    "confidence": null
  },
  {
    "startMs": 317361.75,
    "endMs": 320454.208,
    "text": "Liquidity rewards need eligible positions and funded campaigns.",
    "timestampMs": null,
    "confidence": null
  },
  {
    "startMs": 321253.438,
    "endMs": 324032.271,
    "text": "Some realized arbitrage profit can support reserves.",
    "timestampMs": null,
    "confidence": null
  },
  {
    "startMs": 324877.979,
    "endMs": 329248.854,
    "text": "Families compete for designated trading-fee rights; they do not take the pool's principal.",
    "timestampMs": null,
    "confidence": null
  },
  {
    "startMs": 330033.479,
    "endMs": 334348.646,
    "text": "Real-world assets include Stock Tokens: exposure to assets outside the game.",
    "timestampMs": null,
    "confidence": null
  },
  {
    "startMs": 335152.187,
    "endMs": 339279.917,
    "text": "Commission choices, acquisition, custody and eligibility govern the process.",
    "timestampMs": null,
    "confidence": null
  },
  {
    "startMs": 340068.083,
    "endMs": 342548.063,
    "text": "Holding OMR does not promise everyone a payout.",
    "timestampMs": null,
    "confidence": null
  },
  {
    "startMs": 343445.604,
    "endMs": 345585.438,
    "text": "These systems shape what players can organize.",
    "timestampMs": null,
    "confidence": null
  },
  {
    "startMs": 346374.708,
    "endMs": 348255.5,
    "text": "They cannot decide whom Nico should trust.",
    "timestampMs": null,
    "confidence": null
  },
  {
    "startMs": 351795.771,
    "endMs": 353274.458,
    "text": "The next job comes round.",
    "timestampMs": null,
    "confidence": null
  },
  {
