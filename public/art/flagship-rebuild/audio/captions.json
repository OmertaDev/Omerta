    "timestampMs": null,
    "confidence": null
  },
  {
    "startMs": 43686.813,
    "endMs": 48644.563,
    "text": "That is how a place in this city begins: one decision, then its consequence.",
    "timestampMs": null,
    "confidence": null
  },
  {
