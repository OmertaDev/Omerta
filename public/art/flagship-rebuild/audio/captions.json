    "timestampMs": null,
    "confidence": null
  },
  {
    "startMs": 184798.104,
    "endMs": 187823.604,
    "text": "Bigger risks can cost more: a character can die.",
    "timestampMs": null,
    "confidence": null
  },
  {
    "startMs": 188691,
    "endMs": 192439.958,
    "text": "Your account continues, but an heir keeps only a limited legacy.",
    "timestampMs": null,
    "confidence": null
  },
  {
    "startMs": 193330.042,
    "endMs": 194919.125,
    "text": "Seasons have their own rules.",
    "timestampMs": null,
    "confidence": null
  },
  {
    "startMs": 195805.875,
    "endMs": 200984.396,
    "text": "Eligible gear and vehicles can leave the game, but extracted items stop working inside it.",
    "timestampMs": null,
    "confidence": null
  },
  {
    "startMs": 201960.188,
    "endMs": 205446.021,
    "text": "Combat cannot take unrelated assets from your external wallet.",
    "timestampMs": null,
    "confidence": null
  },
  {
    "startMs": 206432.958,
    "endMs": 207664.333,
    "text": "What do you keep in play?",
    "timestampMs": null,
    "confidence": null
  },
  {
    "startMs": 208562.979,
    "endMs": 210034.958,
    "text": "What are you prepared to lose?",
    "timestampMs": null,
    "confidence": null
  },
  {
    "startMs": 212345.875,
    "endMs": 216304.917,
    "text": "Elsewhere in the city, discoveries can be kept private or shared with permission.",
    "timestampMs": null,
    "confidence": null
  },
  {
    "startMs": 217106.833,
    "endMs": 219913.75,
    "text": "Two investigators may need evidence they found independently.",
    "timestampMs": null,
    "confidence": null
  },
  {
    "startMs": 220704.313,
    "endMs": 222703.792,
    "text": "Copying the same clue is not another witness.",
    "timestampMs": null,
    "confidence": null
  },
  {
    "startMs": 223479.208,
    "endMs": 228633.75,
    "text": "Objects tell stories too: salvage becomes material, and an eligible recipe makes an item",
    "timestampMs": null,
    "confidence": null
  },
  {
    "startMs": 228633.75,
    "endMs": 229840.167,
    "text": "with a traceable history.",
    "timestampMs": null,
    "confidence": null
  },
  {
    "startMs": 230654.354,
    "endMs": 237083.854,
    "text": "Beyond Nico's small Crew, Families pursue larger ambitions: treasury, territory, rivalries and wars.",
    "timestampMs": null,
    "confidence": null
  },
  {
    "startMs": 237874,
    "endMs": 240297.229,
    "text": "Shared operations need contributions and approval.",
    "timestampMs": null,
    "confidence": null
  },
  {
    "startMs": 241090.917,
    "endMs": 242356.563,
    "text": "Convoys can be ambushed.",
    "timestampMs": null,
    "confidence": null
  },
  {
    "startMs": 243154.896,
    "endMs": 245580.896,
    "text": "Commission seats give votes on specific city rules.",
    "timestampMs": null,
    "confidence": null
  },
  {
    "startMs": 246363.063,
    "endMs": 250065.271,
    "text": "Events and the Director's authored situations change the opportunities around you.",
    "timestampMs": null,
    "confidence": null
  },
  {
    "startMs": 252336.667,
    "endMs": 253954.771,
    "text": "Not every rival is at a keyboard.",
    "timestampMs": null,
    "confidence": null
  },
  {
    "startMs": 254740.479,
    "endMs": 256213.396,
    "text": "A player can operate an agent.",
    "timestampMs": null,
    "confidence": null
  },
  {
    "startMs": 257024.604,
    "endMs": 259594,
    "text": "Here it reads its available actions and takes a street job.",
    "timestampMs": null,
    "confidence": null
  },
  {
    "startMs": 260381.729,
    "endMs": 262694.958,
    "text": "Nerve falls; cash and respect change.",
    "timestampMs": null,
    "confidence": null
  },
  {
    "startMs": 263475.667,
    "endMs": 265423.521,
    "text": "The next decision starts from that new state.",
    "timestampMs": null,
    "confidence": null
  },
  {
    "startMs": 266295.229,
    "endMs": 268597.104,
