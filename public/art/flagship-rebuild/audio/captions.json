    "timestampMs": null,
    "confidence": null
  },
  {
    "startMs": 74932.229,
    "endMs": 75863.25,
    "text": "Mara chooses the Gun.",
    "timestampMs": null,
    "confidence": null
  },
  {
    "startMs": 76591.792,
    "endMs": 79408.688,
    "text": "Their specialties are different; their preparation still matters.",
    "timestampMs": null,
    "confidence": null
  },
  {
    "startMs": 80106.896,
    "endMs": 81971.021,
    "text": "Nico starts thinking beyond his next payout.",
    "timestampMs": null,
    "confidence": null
  },
  {
    "startMs": 82776.063,
    "endMs": 84941.917,
    "text": "What can he do that makes someone else want him around?",
    "timestampMs": null,
    "confidence": null
  },
  {
    "startMs": 90383.438,
    "endMs": 91829.917,
    "text": "He buys a sack of coffee.",
    "timestampMs": null,
    "confidence": null
  },
  {
    "startMs": 92734.271,
    "endMs": 95903.208,
    "text": "There is the price, the debit, and the cargo in his trunk.",
    "timestampMs": null,
    "confidence": null
  },
  {
    "startMs": 96790.5,
    "endMs": 98943.292,
    "text": "Getting a bargain is only half the decision.",
    "timestampMs": null,
    "confidence": null
  },
  {
    "startMs": 99861.021,
    "endMs": 100729.271,
    "text": "Goods need moving.",
    "timestampMs": null,
    "confidence": null
  },
  {
    "startMs": 101625.188,
    "endMs": 102761.646,
    "text": "Cars need repairs.",
    "timestampMs": null,
    "confidence": null
  },
  {
    "startMs": 103653.938,
    "endMs": 105936.896,
    "text": "Boats open sea runs with risks of their own.",
    "timestampMs": null,
    "confidence": null
  },
  {
    "startMs": 106830.542,
    "endMs": 109973.125,
    "text": "A business has upkeep; a Kitchen batch takes time.",
    "timestampMs": null,
    "confidence": null
  },
  {
    "startMs": 110866.896,
    "endMs": 115623.292,
    "text": "Races, boxing, the Den and the Speakeasy give people other reasons to return.",
    "timestampMs": null,
    "confidence": null
  },
  {
    "startMs": 116528.083,
    "endMs": 119985.229,
    "text": "Loans, auctions and fixers create other opportunities.",
    "timestampMs": null,
    "confidence": null
  },
  {
    "startMs": 120870.729,
    "endMs": 122643.021,
    "text": "The city rewards paying attention.",
    "timestampMs": null,
    "confidence": null
  },
  {
    "startMs": 125361.583,
    "endMs": 129646.417,
    "text": "Nico forms a Crew, a small circle for mutual aid and chat.",
    "timestampMs": null,
    "confidence": null
  },
  {
    "startMs": 130652.292,
    "endMs": 132666.667,
    "text": "Then comes the Payroll Office job.",
    "timestampMs": null,
    "confidence": null
  },
  {
