  "captions": [
    {
      "startMs": 181.521,
      "endMs": 1659.625,
      "text": "Nico has put up the stake.",
      "timestampMs": null,
      "confidence": null
    },
    {
      "startMs": 2554.604,
      "endMs": 3607.125,
      "text": "One seat is empty.",
      "timestampMs": null,
      "confidence": null
    },
    {
      "startMs": 4575.375,
      "endMs": 8009.812,
      "text": "Fill it with the wrong person, and everyone could go to jail.",
      "timestampMs": null,
      "confidence": null
    },
    {
      "startMs": 8905.396,
      "endMs": 13635.813,
      "text": "This is OMERTÀ, a multiplayer mafia strategy RPG in your browser.",
      "timestampMs": null,
      "confidence": null
    },
    {
      "startMs": 15351.667,
      "endMs": 17651.979,
      "text": "Nico starts with a name and a little cash.",
      "timestampMs": null,
      "confidence": null
    },
    {
      "startMs": 18558.104,
      "endMs": 19852.917,
      "text": "He takes a small job.",
      "timestampMs": null,
      "confidence": null
    },
    {
      "startMs": 20731.479,
      "endMs": 21683.813,
      "text": "Nerve goes down.",
      "timestampMs": null,
      "confidence": null
    },
    {
      "startMs": 22580.063,
      "endMs": 23998.083,
      "text": "Cash and respect go up.",
      "timestampMs": null,
      "confidence": null
    },
    {
      "startMs": 24891.542,
      "endMs": 25449.688,
      "text": "Now what?",
      "timestampMs": null,
      "confidence": null
    },
    {
      "startMs": 26345.458,
      "endMs": 28300.375,
      "text": "Another job could build his bankroll.",
      "timestampMs": null,
      "confidence": null
    },
    {
      "startMs": 29176.688,
      "endMs": 31651.708,
      "text": "Training spends energy to improve his stats.",
      "timestampMs": null,
      "confidence": null
    },
    {
      "startMs": 32533.5,
      "endMs": 36680.042,
      "text": "Banking protects money once it arrives, but the trip leaves it exposed.",
      "timestampMs": null,
      "confidence": null
    },
    {
      "startMs": 37605.229,
      "endMs": 39767.854,
      "text": "Three choices, different risks.",
      "timestampMs": null,
      "confidence": null
    },
    {
      "startMs": 40631.604,
      "endMs": 42791.854,
      "text": "Nico has to choose what matters next.",
      "timestampMs": null,
      "confidence": null
    },
    {
      "startMs": 43686.813,
      "endMs": 48644.563,
      "text": "That is how a place in this city begins: one decision, then its consequence.",
      "timestampMs": null,
      "confidence": null
    },
    {
      "startMs": 52340.083,
      "endMs": 55161.729,
      "text": "As he progresses, six Paths open different ways forward.",
      "timestampMs": null,
      "confidence": null
    },
    {
      "startMs": 55872.146,
      "endMs": 57084.208,
      "text": "The Gun brings street combat.",
      "timestampMs": null,
      "confidence": null
    },
    {
      "startMs": 57811.521,
      "endMs": 59289.271,
      "text": "The Ledger, fronts and trade.",
      "timestampMs": null,
      "confidence": null
    },
    {
      "startMs": 60007.521,
      "endMs": 61338.5,
      "text": "The Kitchen, better cooking.",
      "timestampMs": null,
      "confidence": null
    },
    {
      "startMs": 62049.167,
      "endMs": 63539.896,
      "text": "The Wheel, faster convoys.",
      "timestampMs": null,
      "confidence": null
    },
    {
      "startMs": 64254.167,
      "endMs": 65753.292,
      "text": "The Shadow, quicker searches.",
      "timestampMs": null,
      "confidence": null
    },
    {
      "startMs": 66464.146,
      "endMs": 68320.958,
      "text": "The Ring, stronger duels and bouts.",
      "timestampMs": null,
      "confidence": null
    },
    {
      "startMs": 69016.604,
      "endMs": 70368.708,
      "text": "Every advantage costs something.",
      "timestampMs": null,
      "confidence": null
    },
    {
      "startMs": 71081.896,
      "endMs": 74215.542,
      "text": "Nico chooses the Wheel: faster convoys, slower cooking.",
      "timestampMs": null,
      "confidence": null
    },
    {
      "startMs": 74932.229,
      "endMs": 75863.25,
      "text": "Mara chooses the Gun.",
      "timestampMs": null,
      "confidence": null
    },
    {
      "startMs": 76591.792,
      "endMs": 79408.688,
      "text": "Their specialties are different; their preparation still matters.",
      "timestampMs": null,
      "confidence": null
    },
    {
      "startMs": 80106.896,
      "endMs": 81971.021,
      "text": "Nico starts thinking beyond his next payout.",
      "timestampMs": null,
      "confidence": null
    },
    {
      "startMs": 82776.063,
      "endMs": 84941.917,
      "text": "What can he do that makes someone else want him around?",
      "timestampMs": null,
      "confidence": null
    },
    {
      "startMs": 90383.438,
      "endMs": 91829.917,
      "text": "He buys a sack of coffee.",
      "timestampMs": null,
      "confidence": null
    },
    {
      "startMs": 92734.271,
      "endMs": 95903.208,
      "text": "There is the price, the debit, and the cargo in his trunk.",
      "timestampMs": null,
      "confidence": null
    },
    {
      "startMs": 96790.5,
      "endMs": 98943.292,
      "text": "Getting a bargain is only half the decision.",
      "timestampMs": null,
      "confidence": null
    },
    {
      "startMs": 99861.021,
      "endMs": 100729.271,
      "text": "Goods need moving.",
      "timestampMs": null,
      "confidence": null
    },
    {
      "startMs": 101625.188,
      "endMs": 102761.646,
      "text": "Cars need repairs.",
      "timestampMs": null,
      "confidence": null
    },
    {
      "startMs": 103653.938,
      "endMs": 105936.896,
      "text": "Boats open sea runs with risks of their own.",
      "timestampMs": null,
      "confidence": null
    },
    {
      "startMs": 106830.542,
      "endMs": 109973.125,
      "text": "A business has upkeep; a Kitchen batch takes time.",
      "timestampMs": null,
      "confidence": null
    },
    {
      "startMs": 110866.896,
      "endMs": 115623.292,
      "text": "Races, boxing, the Den and the Speakeasy give people other reasons to return.",
      "timestampMs": null,
      "confidence": null
    },
    {
      "startMs": 116528.083,
      "endMs": 119985.229,
      "text": "Loans, auctions and fixers create other opportunities.",
      "timestampMs": null,
      "confidence": null
    },
    {
      "startMs": 120870.729,
      "endMs": 122643.021,
      "text": "The city rewards paying attention.",
      "timestampMs": null,
      "confidence": null
    },
    {
      "startMs": 125361.583,
      "endMs": 129646.417,
      "text": "Nico forms a Crew, a small circle for mutual aid and chat.",
      "timestampMs": null,
      "confidence": null
    },
    {
      "startMs": 130652.292,
      "endMs": 132666.667,
      "text": "Then comes the Payroll Office job.",
      "timestampMs": null,
      "confidence": null
    },
    {
      "startMs": 133656.708,
      "endMs": 135721.438,
      "text": "This heist needs a wheelman and muscle.",
      "timestampMs": null,
      "confidence": null
    },
    {
      "startMs": 136686.563,
      "endMs": 139619.208,
      "text": "Nico takes the wheelman role and puts up the stake.",
      "timestampMs": null,
      "confidence": null
    },
    {
      "startMs": 140600.854,
      "endMs": 142076.042,
      "text": "The second seat is empty.",
      "timestampMs": null,
      "confidence": null
    },
    {
      "startMs": 143066.729,
      "endMs": 143975.229,
      "text": "Mara joins.",
      "timestampMs": null,
      "confidence": null
    },
    {
      "startMs": 145008.313,
      "endMs": 146165.521,
      "text": "Both names are there.",
      "timestampMs": null,
      "confidence": null
    },
    {
      "startMs": 147241.188,
      "endMs": 149099.833,
      "text": "Preparation improves their odds.",
      "timestampMs": null,
      "confidence": null
    },
    {
      "startMs": 150085.417,
      "endMs": 153014.833,
      "text": "It cannot tell Nico what somebody else will choose.",
      "timestampMs": null,
      "confidence": null
    },
    {
      "startMs": 154006.417,
      "endMs": 154718.958,
      "text": "He commits.",
      "timestampMs": null,
      "confidence": null
    },
    {
      "startMs": 157254.604,
      "endMs": 158273.771,
      "text": "The law was waiting.",
      "timestampMs": null,
      "confidence": null
    },
    {
      "startMs": 159252.979,
      "endMs": 160253.333,
      "text": "Somebody talked.",
      "timestampMs": null,
      "confidence": null
    },
    {
      "startMs": 161941.917,
      "endMs": 163446.292,
      "text": "Both players go to jail.",
      "timestampMs": null,
      "confidence": null
    },
    {
      "startMs": 165994.625,
      "endMs": 167797.104,
      "text": "The result names no informant.",
      "timestampMs": null,
      "confidence": null
    },
    {
      "startMs": 168781.688,
      "endMs": 170997.854,
      "text": "Nico can read exactly what happened.",
      "timestampMs": null,
      "confidence": null
    },
    {
      "startMs": 171998.125,
      "endMs": 174108.542,
      "text": "He still does not know whom to believe.",
      "timestampMs": null,
      "confidence": null
    },
    {
      "startMs": 178357.104,
      "endMs": 179028.167,
      "text": "Jail ends.",
      "timestampMs": null,
      "confidence": null
    },
    {
      "startMs": 179910.771,
      "endMs": 181111.104,
      "text": "The question remains.",
      "timestampMs": null,
      "confidence": null
    },
    {
      "startMs": 182017.271,
      "endMs": 183896.604,
      "text": "Would you invite the same person again?",
      "timestampMs": null,
      "confidence": null
    },
    {
      "startMs": 184798.104,
      "endMs": 187823.604,
      "text": "Bigger risks can cost more: a character can die.",
      "timestampMs": null,
      "confidence": null
    },
    {
      "startMs": 188691,
      "endMs": 192439.958,
      "text": "Your account continues, but an heir keeps only a limited legacy.",
      "timestampMs": null,
      "confidence": null
    },
    {
      "startMs": 193330.042,
      "endMs": 194919.125,
      "text": "Seasons have their own rules.",
      "timestampMs": null,
      "confidence": null
    },
    {
      "startMs": 195805.875,
      "endMs": 200984.396,
      "text": "Eligible gear and vehicles can leave the game, but extracted items stop working inside it.",
      "timestampMs": null,
      "confidence": null
    },
    {
      "startMs": 201960.188,
      "endMs": 205446.021,
      "text": "Combat cannot take unrelated assets from your external wallet.",
      "timestampMs": null,
      "confidence": null
    },
    {
      "startMs": 206432.958,
      "endMs": 207664.333,
      "text": "What do you keep in play?",
      "timestampMs": null,
      "confidence": null
    },
    {
      "startMs": 208562.979,
      "endMs": 210034.958,
      "text": "What are you prepared to lose?",
      "timestampMs": null,
      "confidence": null
    },
    {
      "startMs": 212345.875,
      "endMs": 216304.917,
      "text": "Elsewhere in the city, discoveries can be kept private or shared with permission.",
      "timestampMs": null,
      "confidence": null
    },
    {
      "startMs": 217106.833,
      "endMs": 219913.75,
      "text": "Two investigators may need evidence they found independently.",
      "timestampMs": null,
      "confidence": null
    },
    {
      "startMs": 220704.313,
      "endMs": 222703.792,
      "text": "Copying the same clue is not another witness.",
      "timestampMs": null,
      "confidence": null
    },
    {
      "startMs": 223479.208,
      "endMs": 228633.75,
      "text": "Objects tell stories too: salvage becomes material, and an eligible recipe makes an item",
      "timestampMs": null,
      "confidence": null
    },
    {
      "startMs": 228633.75,
      "endMs": 229840.167,
      "text": "with a traceable history.",
      "timestampMs": null,
      "confidence": null
    },
    {
      "startMs": 230654.354,
      "endMs": 237083.854,
      "text": "Beyond Nico's small Crew, Families pursue larger ambitions: treasury, territory, rivalries and wars.",
      "timestampMs": null,
      "confidence": null
    },
    {
      "startMs": 237874,
      "endMs": 240297.229,
      "text": "Shared operations need contributions and approval.",
      "timestampMs": null,
      "confidence": null
    },
    {
      "startMs": 241090.917,
      "endMs": 242356.563,
      "text": "Convoys can be ambushed.",
      "timestampMs": null,
      "confidence": null
    },
    {
      "startMs": 243154.896,
      "endMs": 245580.896,
      "text": "Commission seats give votes on specific city rules.",
      "timestampMs": null,
      "confidence": null
    },
    {
      "startMs": 246363.063,
      "endMs": 250065.271,
      "text": "Events and the Director's authored situations change the opportunities around you.",
      "timestampMs": null,
      "confidence": null
    },
    {
      "startMs": 252336.667,
      "endMs": 253954.771,
      "text": "Not every rival is at a keyboard.",
      "timestampMs": null,
      "confidence": null
    },
    {
      "startMs": 254740.479,
      "endMs": 256213.396,
      "text": "A player can operate an agent.",
      "timestampMs": null,
      "confidence": null
    },
    {
      "startMs": 257024.604,
      "endMs": 259594,
      "text": "Here it reads its available actions and takes a street job.",
      "timestampMs": null,
      "confidence": null
    },
    {
      "startMs": 260381.729,
      "endMs": 262694.958,
      "text": "Nerve falls; cash and respect change.",
      "timestampMs": null,
      "confidence": null
    },
    {
      "startMs": 263475.667,
      "endMs": 265423.521,
      "text": "The next decision starts from that new state.",
      "timestampMs": null,
      "confidence": null
    },
    {
      "startMs": 266295.229,
      "endMs": 268597.104,
      "text": "Permissions and resources still limit what it can do.",
      "timestampMs": null,
      "confidence": null
    },
    {
      "startMs": 269375.417,
      "endMs": 271175.083,
      "text": "The city's NPCs are separate.",
      "timestampMs": null,
      "confidence": null
    },
    {
      "startMs": 271984.25,
      "endMs": 275971.083,
      "text": "Whether you bring friends or build an agent, the choices still have consequences.",
      "timestampMs": null,
      "confidence": null
    },
    {
      "startMs": 280336.75,
      "endMs": 282551.167,
      "text": "Nico needs equipment, access and people.",
      "timestampMs": null,
      "confidence": null
    },
    {
      "startMs": 283341.813,
      "endMs": 286121.083,
      "text": "Money helps, but the balances have different jobs.",
      "timestampMs": null,
      "confidence": null
    },
    {
      "startMs": 286925.646,
      "endMs": 288514.875,
      "text": "Game cash pays for city life.",
      "timestampMs": null,
      "confidence": null
    },
    {
      "startMs": 289315.063,
      "endMs": 294329.604,
      "text": "In-game OMR buys selected gear and services; some privileges require holding or staking it.",
      "timestampMs": null,
      "confidence": null
    },
    {
      "startMs": 295191.75,
      "endMs": 296919.854,
      "text": "Most OMR spends recycle it.",
      "timestampMs": null,
      "confidence": null
    },
    {
      "startMs": 297797.167,
      "endMs": 300131.625,
      "text": "Wallet OMR is separate, onchain.",
      "timestampMs": null,
      "confidence": null
    },
    {
      "startMs": 300937.479,
      "endMs": 303298.146,
      "text": "The funded Window spends OMR for game cash.",
      "timestampMs": null,
      "confidence": null
    },
    {
      "startMs": 304088.583,
      "endMs": 305460.854,
      "text": "That conversion goes one way.",
      "timestampMs": null,
      "confidence": null
    },
    {
      "startMs": 306252.521,
      "endMs": 308586.042,
      "text": "Game rewards are not automatic wallet payouts.",
      "timestampMs": null,
      "confidence": null
    },
    {
      "startMs": 309360.083,
      "endMs": 313057.875,
      "text": "Trading fees fund developer, community, asset and liquidity budgets.",
