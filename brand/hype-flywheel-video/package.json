{
  "name": "hype-flywheel-video",
  "version": "1.0.0",
  "description": "OMERTA bullish game-economy flywheel film",
  "repository": {},
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@remotion/cli": "4.0.523",
    "@remotion/fonts": "4.0.523",
    "@remotion/media": "4.0.523",
    "@remotion/tailwind-v4": "4.0.523",
    "@remotion/transitions": "4.0.523",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.523",
    "tailwindcss": "4.0.0"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.523",
    "@types/react": "19.2.7",
    "@types/web": "0.0.166",
    "eslint": "9.19.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "dev": "remotion studio src/index.ts --public-dir ../../public --no-open",
    "build": "remotion bundle",
    "assets": "node scripts/generate-fal-assets.mjs --video-ids flywheel-v3-loop --cap 1.5",
    "render": "remotion render src/index.ts HypeFlywheelV3 ../../public/art/hype-flywheel-v3.mp4 --public-dir ../../public --codec h264 --crf 18 --audio-bitrate 256k --color-space bt709 --overwrite",
    "render:preview": "remotion render src/index.ts HypeFlywheelV3 ../../output/hype-flywheel-v3-preview.mp4 --public-dir ../../public --scale 0.5 --codec h264 --crf 24 --audio-bitrate 160k --overwrite",
    "still": "remotion still src/index.ts HypeFlywheelV3 ../../output/hype-flywheel-v3-still.png --public-dir ../../public --frame 1350 --overwrite",
    "upgrade": "remotion upgrade",
    "lint": "eslint src && tsc"
  },
  "sideEffects": [
    "*.css"
  ]
}
