# Copy to omerta-contracts/.env (gitignored). Never put a private key in this file.
# The zero values marked REQUIRED intentionally make the deploy script abort until you replace them
# with reviewed launch values.

EXPECTED_CHAIN_ID=46630

# Phase 0 Safe v1.4.1. SAFE_OWNERS is comma-delimited; use public addresses only.
SAFE_SINGLETON=0x29fcB43b46531BcA003ddC8FCB67FFE91900C762
SAFE_PROXY_FACTORY=0x4e1DCf7AD4e460CfD30791CCC4F9c8a4f820ec67
SAFE_FALLBACK_HANDLER=0xfd0732Dc9E303f09fCEf3a7388Ad10A83459Ec99
SAFE_OWNERS=0x0000000000000000000000000000000000000000
SAFE_THRESHOLD=1
SAFE_SALT_NONCE=0

# Phase 1 owner and operational public addresses. Fill SAFE with the Phase 0 output.
SAFE=0x0000000000000000000000000000000000000000
SIGNER=0x0000000000000000000000000000000000000000
DEV_WALLET=0x0000000000000000000000000000000000000000
VIG_WALLET=0x0000000000000000000000000000000000000000
POL_WALLET=0x0000000000000000000000000000000000000000

# Phase 1 core. Token amounts are integer wei (18 decimals for OMR).
DAILY_CAP_OMR=0
STAKING_APY_BPS=1400
VIG_BPS=2500
MINT_FEE_WEI=10000000000000000
RESPAWN_FEE_WEI=100000000000000000
BASE_URI=ipfs://REPLACE_WITH_PINNED_GEAR_CID/
DEED_IMAGE_BASE=https://www.omerta.fun/v1/deeds/plate/
DEED_EXTERNAL_BASE=https://www.omerta.fun/deed/
DEED_DAILY_MINT_CAP=0
DYNASTY_BASE_URI=https://www.omerta.fun/v1/identity/
DYNASTY_ROYALTY_BPS=500
DYNASTY_DAILY_MINT_CAP=0
STOCK_DEFAULT_DAILY_CAP=0

# Path A immutable bond split. Vig is the constructor's remainder.
BOND_POL_BPS=7500
BOND_DEV_BPS=1500
BOND_RWA_BPS=500
BOND_VIG_BPS=500
BOND_DAILY_CAP_OMR=0
BOND_MAX_OMR_PER_ETH=0

# Use 0/0 to deploy the genesis oracle closed. For a launch window, set an 18-decimal OMR/ETH
# price and a future Unix timestamp together.
GENESIS_PRICE_OMR_PER_ETH=0
GENESIS_VALID_UNTIL=0

# Phase 2 Bank (existing live contracts; scripts reject zero/no-code addresses).
BANK_ASSET=0x0000000000000000000000000000000000000000
BANK_ERC4626_VAULT=0x0000000000000000000000000000000000000000

# Phase 3 TWAP (fill from Phase 1 + the initialized V2-compatible OMR/WETH pair).
OMR_ADDRESS=0x0000000000000000000000000000000000000000
OMR_V2_PAIR=0x0000000000000000000000000000000000000000
TWAP_PERIOD_SECONDS=1800

# Phase 4 v4 hook. This address has byte-identical PoolManager runtime code on Robinhood
# mainnet (4663) and testnet (46630); still re-check `cast code` immediately before deployment.
V4_POOL_MANAGER=0x8366a39cc670b4001a1121b8f6a443a643e40951
