  "model": {
    "assets": "StreetDeed ERC721, canonical ERC6551 ordinary ERC20 stocks/native balance, payer canonical OMR allowance",
    "oracle": "lifecycleOperator attests serial authoritative game deaths, same-account heirs, and fresh safe exit/payment state. Undisclosed offchain deaths cannot invalidate already finalized exits; backend ordering/finality required.",
    "coverage": "per-deed per-dynasty retained intervals, evaluated at authoritative deathAt; no same-second initial cover, no retroactive postmortem cover; protected route same-dynasty heir after deathAt+86400, uncovered route killer; every path remains vault-locked until authorized exit",
    "pricing": "previous completed full UTC day actual raw OMR swap delta magnitude; clamp(volume/20000,1e18,25e18); today price bound in owner request, maxBurn consent; all prepaid 24h periods priced at purchase; 7-day horizon; LP/donations/direct transfers/reverts excluded",
    "burn": "sealed runtime-pinned ProtocolCustody caller plus payer allowance; ERC20 totalSupply destruction, no treasury recycle or issuance",
    "external_calls": "ERC721 safe transfers restricted vault callbacks; canonical registry creation; static ERC1271; canonical OMR burnFrom; ordinary ERC20 fixed-owner withdrawals; native fixed-owner withdrawal guarded by reentrancy lock"
  },
