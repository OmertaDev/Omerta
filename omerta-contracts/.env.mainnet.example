# Copy to .env.mainnet. This file contains public deployment configuration only.
# Never put a private key, mnemonic, or keystore password here.

EXPECTED_CHAIN_ID=4663
EXPECTED_SOURCE_COMMIT=REPLACE_WITH_40_CHARACTER_RELEASE_COMMIT
EXPECTED_DEPLOYER_NONCE=REPLACE_WITH_CURRENT_MAINNET_NONCE
CORE_AUDIT_REPORT_SHA256=REPLACE_WITH_64_CHARACTER_SHA256
CORE_SIGNER_AUDIT_INCLUDED=true

# Phase 0 Safe v1.4.1. Use three independently controlled mainnet owners and a 2-of-3 threshold.
SAFE_SINGLETON=0x29fcB43b46531BcA003ddC8FCB67FFE91900C762
SAFE_PROXY_FACTORY=0x4e1DCf7AD4e460CfD30791CCC4F9c8a4f820ec67
SAFE_FALLBACK_HANDLER=0xfd0732Dc9E303f09fCEf3a7388Ad10A83459Ec99
SAFE_OWNERS=0x0000000000000000000000000000000000000000,0x0000000000000000000000000000000000000000,0x0000000000000000000000000000000000000000
SAFE_THRESHOLD=2
SAFE_SALT_NONCE=REPLACE_WITH_NONZERO_UNIQUE_NONCE

# The Phase 0 broadcaster is owner 1. Phase 1 may use a separate, gas-funded deployer.
DEPLOYER=0x0000000000000000000000000000000000000000
SAFE=0x0000000000000000000000000000000000000000
SIGNER=0x0000000000000000000000000000000000000000
DEV_WALLET=0x0000000000000000000000000000000000000000
VIG_WALLET=0x0000000000000000000000000000000000000000
POL_WALLET=0x0000000000000000000000000000000000000000

# Phase 1 constructor values. These conservative caps mirror the completed testnet rehearsal.
DAILY_CAP_OMR=1000000000000000000000
STAKING_APY_BPS=1400
VIG_BPS=2500
MINT_FEE_WEI=10000000000000000
RESPAWN_FEE_WEI=100000000000000000
BASE_URI=ipfs://REPLACE_WITH_PINNED_GEAR_CID/
DEED_IMAGE_BASE=https://www.omerta.fun/v1/deeds/plate/
DEED_EXTERNAL_BASE=https://www.omerta.fun/deed/
DEED_DAILY_MINT_CAP=10
DYNASTY_BASE_URI=https://www.omerta.fun/v1/identity/
DYNASTY_ROYALTY_BPS=500
DYNASTY_DAILY_MINT_CAP=10
STOCK_DEFAULT_DAILY_CAP=1

# Path A immutable bond split. The Vig share is the constructor remainder.
BOND_POL_BPS=7500
BOND_DEV_BPS=1500
BOND_RWA_BPS=500
BOND_VIG_BPS=500
BOND_DAILY_CAP_OMR=1000000000000000000000
BOND_MAX_OMR_PER_ETH=15000000000000000000000

# First cut is deployment-only: genesis issuance stays closed and OMR.minter remains unset.
GENESIS_PRICE_OMR_PER_ETH=0
GENESIS_VALID_UNTIL=0

# Later phases. Leave zero until their separate release gates clear.
BANK_ASSET=0x0000000000000000000000000000000000000000
BANK_ERC4626_VAULT=0x0000000000000000000000000000000000000000
OMR_ADDRESS=0x0000000000000000000000000000000000000000
OMR_V2_PAIR=0x0000000000000000000000000000000000000000
V2_FACTORY=0x0000000000000000000000000000000000000000
WETH_ADDRESS=0x0000000000000000000000000000000000000000
# Shared minimum window for the legacy V2 oracle script and the canonical post-genesis v4 oracle.
# DeployV4TwapOracle additionally consumes V4_POOL_MANAGER + OMERTA_HOOK_ADDRESS below and needs no WETH.
TWAP_PERIOD_SECONDS=1800
V4_POOL_MANAGER=0x8366a39cc670b4001a1121b8f6a443a643e40951

# Official Uniswap genesis stack on Robinhood Chain. DeployHook binds the pool forever to this
# singleton LBPStrategy, and the unsigned config builder verifies its CCA factory immutable.
LIQUIDITY_LAUNCHER=0x0000FffFBE8efE702c8703aE3477FF5dE3d319C0
LBP_STRATEGY=0x05d552391067389EE44fec3924157ed33F976000
CCA_FACTORY=0x000000001F26a0044BaA66024e7b6599c61963F8
PERMIT2=0x000000000022D473030F116dDEE9F6B43aC78BA3
POSITION_MANAGER=0x58daec3116aae6D93017bAAea7749052E8a04fA7

# Filled only after the mined launch hook and ownerless proceeds splitter are deployed and verified.
OMERTA_HOOK_ADDRESS=0x0000000000000000000000000000000000000000
GENESIS_PROCEEDS_SPLITTER=0x0000000000000000000000000000000000000000
TREASURY_RECIPIENT=0x0000000000000000000000000000000000000000
VIG_RECIPIENT=0x0000000000000000000000000000000000000000
DEV_RECIPIENT=0x0000000000000000000000000000000000000000
